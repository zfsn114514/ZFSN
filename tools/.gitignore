# 脚本运行产生的缓存 / 编译产物，不需要进仓库
.cache/
__pycache__/
*.pyc

# dev/ 下临时产出的截图（排查样式用，看完就删）
dev/_shots/

# ★ 含密钥的真实配置，绝不提交！
#   历史上它曾被提交过，旧 Steam API Key 因此泄露并被 Steam 撤销。
#   模板见 config.example.json（那个是可以提交的）。
config.json

# 临时中间文件
_tmp_*.json
_backup_*.json

# ZF语音首个管理员初始化脚本生成的 SQL（含密码哈希，执行完即删）
voice_admin_init.sql

# 本地 Worker 运行时的数据（含本地账号哈希与头像，绝不提交）
dev/.voice-dev.sqlite*
dev/.voice-media/
dev/.voice-dev-credentials.txt

# 可选高级模式：自建 LiveKit 的真实配置含 API Secret，只提交 .example 模板
livekit/livekit.yaml
livekit/.env
livekit/livekit-server.exe

# 后端单实例锁（运行时生成）
livekit/backend.lock
