# ── Windows 批处理脚本的换行与编码 ────────────────────────────────
#
# cmd.exe 要求 .bat 必须是 CRLF。LF-only 的批处理会在多字节 UTF-8 字符
# 中间错位切分，整份文件被撕成碎片逐行当命令执行（满屏"不是内部或外部命令"）。
*.bat text eol=crlf

# 根目录旧发布脚本仍使用 GBK；tools/ 更新菜单使用 UTF-8 + chcp 65001。
# 保留旧脚本字节，其余 BAT 按上面的规则检出为 CRLF。
更新github.bat       -text
# 拉取脚本同样用 GBK 写中文提示，必须原样保存字节，
# 否则 git 的 text 规范化会在跨平台检出时改动它。
拉取GitHub更新.bat   -text

# ── 其它文本统一按 LF 存库 ───────────────────────────────────────
*.js   text eol=lf
*.py   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
# SVG cursor resources must be stable across Windows/Linux checkouts.
*.svg text eol=lf
