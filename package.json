{
  "name": "zfsn-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZFSN 个人主页 —— Cloudflare Worker（静态资源 + API）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",

    "d1:create": "wrangler d1 create zfsn-db",
    "d1:init": "wrangler d1 execute zfsn-db --remote --file=./schema/0001_init.sql",
    "d1:init:local": "wrangler d1 execute zfsn-db --local --file=./schema/0001_init.sql",
    "voice:d1": "wrangler d1 execute zfsn-db --remote --file=./schema/0003_voice.sql",
    "voice:d1:local": "wrangler d1 execute zfsn-db --local --file=./schema/0003_voice.sql",
    "voice:init-admin": "node tools/migrate/voice_init_admin.mjs",
    "voice:dev": "node --no-warnings tools/dev/voice-dev-server.mjs",
    "voice:test": "node --no-warnings tests/voice/voice-auth.test.mjs",
    "voice:test:entry": "node --no-warnings tests/voice/voice-entry.test.mjs",
    "voice:test:session": "node --no-warnings tests/voice/voice-session.test.mjs",
    "voice:test:selfhost": "node --no-warnings tests/voice/voice-selfhost.test.mjs",
    "voice:test:e2e": "node --no-warnings tests/voice/voice-realtime.e2e.mjs",
    "voice:test:ui": "node --no-warnings tests/voice/voice-ui.cdp.mjs",
    "voice:test:all": "npm run voice:test:entry && npm run voice:test && npm run voice:test:session && npm run voice:test:selfhost && npm run voice:test:e2e && npm run voice:test:ui && npm run voice:test:settings && npm run voice:test:gate && npm run voice:test:mobile",
    "voice:selfhost": "node --no-warnings tools/livekit/voice-media-server.mjs run",
    "voice:selfhost:check": "node --no-warnings tools/livekit/voice-media-server.mjs doctor",

    "kv:create": "wrangler kv namespace create zfsn-media",
    "kv:list": "wrangler kv key list --binding MEDIA --remote",

    "migrate:sql": "node tools/migrate/export_seed.mjs",
    "migrate:seed": "wrangler d1 execute zfsn-db --remote --file=./tools/migrate/seed.sql",
    "migrate:media": "node tools/migrate/upload_media.mjs",

    "password": "node tools/migrate/set_password.mjs",
    "voice:test:settings": "node --no-warnings tests/voice/voice-settings.cdp.mjs",
    "voice:test:gate": "node --no-warnings tests/voice/voice-gate.cdp.mjs",
    "voice:test:mobile": "node --no-warnings tests/voice/voice-mobile.cdp.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
