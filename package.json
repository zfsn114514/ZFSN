{
  "name": "zfsn-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZFSN 个人主页 —— Cloudflare Worker（静态资源 + API）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",

    "d1:create": "wrangler d1 create zfsn-db",
    "d1:init": "wrangler d1 execute zfsn-db --remote --file=./schema/0001_init.sql",
    "d1:init:local": "wrangler d1 execute zfsn-db --local --file=./schema/0001_init.sql",

    "kv:create": "wrangler kv namespace create zfsn-media",
    "kv:list": "wrangler kv key list --binding MEDIA --remote",

    "migrate:sql": "node tools/migrate/export_seed.mjs",
    "migrate:seed": "wrangler d1 execute zfsn-db --remote --file=./tools/migrate/seed.sql",
    "migrate:media": "node tools/migrate/upload_media.mjs",

    "password": "node tools/migrate/set_password.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
