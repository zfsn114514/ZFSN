<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <!-- PvZ mainpak is deliberately split into extensionless 8 MiB files. -->
      <mimeMap fileExtension=".00" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".01" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".02" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".03" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".04" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".05" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
