# 更新github.bat 用的提交说明（UTF-8），不需要进仓库
.commitmsg.txt

# 数据备份（带时间戳），不进仓库
*.bak_*

# git bundle 备份（含完整历史，可能含密钥），绝不进仓库
*.bundle

# ── 迁移产物 ──────────────────────────────────────────────────
# tools/migrate/export_seed.mjs 生成，里面是**真实数据**：
#   留言的访客 IP、UA、归属地，以及管理员密码哈希。
# 仓库是公开的，这些绝不能提交。迁移完成后建议直接删掉。
tools/migrate/*.sql

# 上传脚本在无法起子进程时的降级产物（键名 → 临时分片文件路径）
tools/migrate/.kv-plan.tsv

# ── Worker 开发依赖与本地状态 ──────────────────────────────────
# node_modules 几千个文件，提交上去既没意义又污染仓库；
# .wrangler 是 wrangler dev 的本地模拟状态（含 D1/KV 的本地副本）。
# （部署本身不需要这两个目录 —— Worker 代码零第三方依赖。）
node_modules/
.wrangler/

# ── 图片优化前的原图备份 ───────────────────────────────────────
# tools/dev/optimize_images.py 会把优化前的原图备份到这里（约 32 MB）。
# 它们只是「万一压坏了好还原」的兜底，**不进仓库**：
#   ① 体积比站点本身还大，提交一次仓库就翻倍；
#   ② 线上根本用不到（.assetsignore 也排除了 tools/）。
# 需要长期保存就自己拷一份到网盘/移动硬盘。
tools/orig-images/
